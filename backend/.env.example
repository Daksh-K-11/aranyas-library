# MongoDB connection string (Atlas free tier works)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=library

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma separated browser origins allowed to call the API (your frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.netlify.app

# Optional: free Google Books API key (1000 requests/day). Without it the
# shared anonymous quota is often exhausted and Google lookups return 429.
GOOGLE_BOOKS_API_KEY=

# Optional
LOOKUP_TIMEOUT_SECONDS=6
MAX_UPLOAD_BYTES=3145728

# ---- Email (verification + password reset codes) ----
# development: codes are printed in the server log if SMTP is not set.
# production: set SMTP, otherwise users cannot verify their email.
APP_ENV=development
APP_NAME=Athenaeum
# Any SMTP server. Free options:
#   Gmail (App Password): smtp.gmail.com, 587, SMTP_USE_SSL=false
#   Brevo (300/day):       smtp-relay.brevo.com, 587
#   Resend (3000/month):   smtp.resend.com, 465, SMTP_USE_SSL=true, username "resend"
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Athenaeum
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
